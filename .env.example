# Copy to .env.local and fill in real values (.env.local is gitignored).
# DATABASE_URL matches the Postgres service in docker-compose.yml.
DATABASE_URL=""
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Coach spend. Sign-ups are open and the API key is live, so both matter:
# the per-user cap limits one person, the global cap bounds the bill.
# A real family never meets these — a boss costs at most four generations
# and a player can hold at most six lanes.
COACH_DAILY_LIMIT=30
COACH_GLOBAL_DAILY_LIMIT=1000
